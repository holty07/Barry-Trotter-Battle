{
  "name": "hogwarts-battle",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run cf-typegen -w @hb/worker",
    "dev": "npm run dev -w @hb/web",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "lint": "eslint .",
    "content:check": "npm run content:check -w @hb/content --if-present",
    "content:import": "npm run content:import -w @hb/content --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "workerd@1.20260907.1": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
